{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "\u256d\u2500\ue0b2",
          "background": "#ffffff",
          "foreground": "#000000",
          "template": " {{ .Icon }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#005fdf",
          "foreground": "#ffffff",
          "properties": {
            "style": "unique",
            "max_depth": 4
          },
          "template": " \uf07c {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#00ffff",
          "foreground": "#000000",
          "properties": {
            "branch_icon": "\uf126 ",
            "fetch_status": true
          },
          "template": " {{ .HEAD }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "node",
          "style": "powerline",
          "invert_powerline": true,
          "powerline_symbol": "\ue0b2",
          "background": "#ffff00",
          "foreground": "#000000",
          "template": " {{ .Full }} \ue718 "
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "invert_powerline": true,
          "powerline_symbol": "\ue0b2",
          "background": "#ff8700",
          "foreground": "#000000",
          "template": " {{ .FormattedMs }} \uf252 "
        },
        {
          "type": "status",
          "style": "powerline",
          "invert_powerline": true,
          "powerline_symbol": "\ue0b2",
          "background": "#ffffff",
          "foreground": "#000000",
          "background_templates": [
            "{{ if gt .Code 0 }}#ff0000{{ end }}"
          ],
          "template": " {{ if gt .Code 0 }}\uf00d {{ .Code }}{{ else }}\uf42e{{ end }} "
        },
        {
          "type": "time",
          "style": "diamond",
          "trailing_diamond": "\ue0b0\u2500\u256e",
          "background": "#ffffff",
          "foreground": "#000000",
          "template": " {{ .CurrentDate | date \"15:04:05\" }} \uf017 "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#ffffff",
          "template": "\u2570\u2500\u276f "
        }
      ]
    }
  ]
}
