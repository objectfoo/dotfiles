{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "blocks": [
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "session",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b0",
          "foreground": "#111111",
          "background": "#f8f8f8",
          "template": " {{ .UserName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#ffffff",
          "background": "#005fdf",
          "properties": {
            "cache_duration": "none",
            "home_icon": "~",
            "mapped_locations": {
              "/mnt/winhome": "winhome"
            },
            "max_depth": 4,
            "style": "folder"
          },
          "template": " \ueb06 {{ .Parent }}{{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#111111",
          "background": "#00e5ff",
          "properties": {
            "branch_icon": "\ue725 ",
            "branch_identical_icon": "=",
            "branch_ahead_icon": "\u2191{{ .Ahead }}",
            "branch_behind_icon": "\u2193{{ .Behind }}",
            "cache_duration": "none",
            "display_status": true,
            "fetch_status": true
          },
          "template": " {{ .HEAD }}{{ if or .Working.Changed .Staging.Changed }} {{ if .Staging.Changed }}\uf046 {{ .Staging.String }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ end }} "
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#111111",
          "background": "#fff200",
          "properties": {
            "cache_duration": "none"
          },
          "template": " \ue718 {{ .Full }} "
        },
        {
          "type": "npm",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#111111",
          "background": "#ff8c00",
          "properties": {
            "cache_duration": "none"
          },
          "template": " \ue71e {{ .Full }} "
        },
        {
          "type": "status",
          "style": "diamond",
          "trailing_diamond": "\ue0b4",
          "foreground": "#ffffff",
          "background": "#d90429",
          "background_templates": [
            "{{ if gt .Code 0 }}#d90429{{ end }}",
            "{{ if eq .Code 0 }}transparent{{ end }}"
          ],
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ffffff{{ end }}",
            "{{ if eq .Code 0 }}transparent{{ end }}"
          ],
          "template": " \uf00d {{ .Code }} ",
          "properties": {
            "always_enabled": true
          }
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#00ff85",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ff4d6d{{ end }}"
          ],
          "template": "❯ "
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true
}
