{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "blocks": [
    {
      "alignment": "left",
      "type": "prompt",
      "segments": [
        {
          "type": "status",
          "style": "diamond",
          "foreground": "#ffffff",
          "background": "#ff0000",
          "background_templates": [
            "{{ if gt .Code 0 }}#ff0000{{ end }}"
          ],
          "template": " \uF00D {{ .Code }} ",
          "properties": {
            "always_enabled": false
          }
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\uE0B0",
          "foreground": "#ffffff",
          "background": "#005fdf",
          "properties": {
            "cache_duration": "none",
            "style": "unique",
            "max_depth": 4
          },
          "template": " \uEB06 {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\uE0B0",
          "foreground": "#000000",
          "background": "#00ffff",
          "properties": {
            "branch_icon": "",
            "branch_identical_icon": "",
            "branch_ahead_icon": "",
            "branch_behind_icon": "",
            "fetch_status": true,
            "display_status": true
          },
          "template": " \uF126 {{ .HEAD }}{{ if .Staging.Changed }} \uF046 {{ .Staging.String }}{{ end }}{{ if .Working.Changed }} \uF044 {{ .Working.String }}{{ end }} "
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "\uE0B0",
          "foreground": "#000000",
          "background": "#ffff00",
          "properties": {
            "cache_duration": "none"
          },
          "template": " \uE718 {{ .Full }} "
        },
        {
          "type": "npm",
          "style": "powerline",
          "powerline_symbol": "\uE0B0",
          "foreground": "#000000",
          "background": "#ffffff",
          "properties": {
            "cache_duration": "none"
          },
          "template": " \uE71E {{ .Full }} "
        }
      ]
    }
  ]
}
