# EditorConfig — https://editorconfig.org
root = true

[*]
end_of_line = crlf
insert_final_newline = true
charset = utf-8
indent_size = 2
indent_style = tab


[Jenkinsfile]
indent_style = space
indent_size = 4
end_of_line = lf

[*.sh]
end_of_line = lf
insert_final_newline = false
charset = utf-8
indent_size = 4
indent_style = space

[{.travis.yml,whiskey.yml}]
indent_size = 2
indent_style = space
insert_final_newline = unset
