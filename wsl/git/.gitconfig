[user]
	name = Your Name
	email = you@users.noreply.github.com

[init]
	defaultBranch = main

[core]
	excludesFile = ~/.gitignore_global

[safe]
	directory = /mnt/winhome
	directory = /mnt/winhome/dotfiles

# Keep this include last so host settings override local defaults when duplicated.
[include]
	path = /mnt/winhome/.gitconfig
