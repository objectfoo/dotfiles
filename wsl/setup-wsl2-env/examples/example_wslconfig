# WSL2 Configuration for Windows 11 Development Environment
# Location: C:\Users\<YourUsername>\.wslconfig
# 
# This configuration optimizes WSL2 for front-end development on Windows 11 (build 22H2+).
# Adjust 'processors' and 'memory' to match your machine specifications.
# 
# For Windows versions before 22H2, some networking settings may not be available.
# Start with essential settings and add advanced features incrementally.

[wsl2]
# === RESOURCE ALLOCATION ===
# Allocate CPU cores to WSL (adjust based on your system)
# Recommended: 50-75% of total cores; leave rest for Windows
processors=8

# Allocate memory to WSL (adjust based on your system)
# Recommended: 50% of total RAM; WSL will compress and release unused memory
memory=8GB

# Disable swap to improve performance and prevent disk thrashing
# WSL will reclaim memory automatically with autoMemoryReclaim
swap=0

# === NETWORKING (requires Windows 11 22H2+) ===
# Use mirrored networking mode to simplify localhost and network troubleshooting
# Makes WSL network interfaces visible to Windows and vice versa
networkingMode=mirrored

# Enable DNS tunneling for more reliable DNS resolution
# Works best with mirrored networking mode
dnsTunneling=true

# Forward localhost connections between Windows and WSL
localhostForwarding=true

# Automatically proxy Windows HTTP/HTTPS settings to WSL
autoProxy=true

# Enable Windows-side firewall for WSL network traffic
# Requires Windows 11 build 22H2 or later
firewall=true

# === FILESYSTEM PERFORMANCE ===
# Apply kernel command line parameters for better performance
# sysctl.vm.swappiness=10 reduces memory swapping
kernelCommandLine=sysctl.vm.swappiness=10

# Enable nested virtualization for Docker Desktop and other VM tools
nestedVirtualization=true

# === GPU & GUI ===
# Enable GUI applications and GPU acceleration for WSL
guiApplications=true

# === EXPERIMENTAL FEATURES ===
[experimental]
# Gradually return unused memory to Windows instead of holding it
# Helps prevent WSL from consuming all available RAM
autoMemoryReclaim=gradual

# Use sparse virtual disk format to prevent disk space bloat
# Allows the virtual disk to shrink when data is deleted
sparseVhd=true
