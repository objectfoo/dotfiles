# WSL2 Minimal Configuration (Windows 11 21H2+)
# Location: C:\Users\<YourUsername>\.wslconfig
#
# Conservative setup for systems with Windows 11 build 21H2 or resource constraints.
# Some features (mirrored networking, dnsTunneling, firewall) require Windows 11 22H2+.
#
# After WSL stabilizes, gradually enable advanced features from example_wslconfig.

[wsl2]
# === RESOURCE ALLOCATION ===
# Set based on your machine; use less for resource-constrained systems
processors=4
memory=4GB
swap=0

# === BASIC NETWORKING ===
# Standard WSL2 networking (works on 21H2+)
dnsTunneling=true
localhostForwarding=true

# === FILESYSTEM ===
# Improve file performance with metadata options
kernelCommandLine=sysctl.vm.swappiness=10

[experimental]
# Memory cleanup to prevent resource bloat
autoMemoryReclaim=gradual
sparseVhd=true
